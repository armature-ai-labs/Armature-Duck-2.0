# Microduck Studio systemd service (autostart).
# Install: sudo install -m 644 microduck-studio.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now microduck-studio
# Remove: sudo systemctl disable --now microduck-studio && sudo rm /etc/systemd/system/microduck-studio.service && sudo systemctl daemon-reload
# Resource limits prevent Studio from starving robotd (50 Hz control loop).
# Do not wait for network-online: Studio binds 0.0.0.0 and reconnects to robotd automatically.
[Unit]
Description=Armature x Microduck Studio (Web Console, port 8000)
After=network.target

[Service]
User=radxa
Group=radxa
WorkingDirectory=/home/radxa/studio-dev
ExecStart=/usr/bin/python3 -I run.py --listen 0.0.0.0:8000
Restart=on-failure
RestartSec=5
Nice=10
CPUWeight=20
CPUQuota=60%
MemoryMax=300M

[Install]
WantedBy=multi-user.target
