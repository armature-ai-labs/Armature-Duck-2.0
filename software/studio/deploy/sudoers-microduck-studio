# /etc/sudoers.d/microduck-studio (root:root 0440). Validate with visudo -cf before installing.
# Allows only the root helper full path; verbs and stdin JSON are validated by the helper.
# Swap comments below if running Studio under a dedicated microduck-studio user instead of radxa.
radxa ALL=(root) NOPASSWD: /usr/local/sbin/microduck-helper
#microduck-studio ALL=(root) NOPASSWD: /usr/local/sbin/microduck-helper
